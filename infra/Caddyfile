# Oak & Ember Press — Caddy 2
# Automatic HTTPS (Let's Encrypt), HTTP/3, static files from the rsync target.
{
	email hello@oakandemberpress.com
}

www.oakandemberpress.com {
	redir https://oakandemberpress.com{uri} permanent
}

oakandemberpress.com {
	root * /srv/www/oakandemberpress.com
	encode zstd gzip
	file_server {
		precompressed br gzip
	}

	# Astro's hashed assets never change: cache for a year. HTML stays fresh.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /brand/* Cache-Control "public, max-age=604800"
	header /catalog/* Cache-Control "public, max-age=604800"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output file /var/log/caddy/oakandemberpress.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
